# Phase 1 uses local ws:// through the Vite development proxy.
SFT_HOST=127.0.0.1
SFT_PORT=3000
SFT_HEARTBEAT_INTERVAL_MS=15000
SFT_HEARTBEAT_TIMEOUT_MS=45000
SFT_DATABASE_PATH=data/sft.sqlite
SFT_STORAGE_ROOT=storage
SFT_SESSION_TTL_MS=1800000
SFT_MAX_FILE_SIZE_BYTES=536870912
SFT_DEFAULT_QUOTA_BYTES=1073741824
SFT_DEFAULT_MAX_FILES=1000
SFT_UPLOAD_CHUNK_SIZE=262144
SFT_MAX_ACTIVE_UPLOADS_GLOBAL=32
SFT_MAX_ACTIVE_UPLOADS_PER_USER=3
SFT_DOWNLOAD_CHUNK_SIZE=262144
SFT_DOWNLOAD_ACK_TIMEOUT_MS=15000
SFT_MAX_ACTIVE_DOWNLOADS_GLOBAL=32
SFT_MAX_ACTIVE_DOWNLOADS_PER_USER=3

# Only used by `npm run db:init --workspace @sft/server -- --seed-test-users`.
# Set strong local test passwords in .env; never commit their real values.
SFT_SEED_ALICE_PASSWORD=
SFT_SEED_BOB_PASSWORD=

# HTTPS/WSS local demo: run npm run cert:generate, then trust dev-ca.pem.
SFT_TLS_CERT_PATH=certs/dev-server.pem
SFT_TLS_KEY_PATH=certs/dev-server-key.pem
SFT_REQUIRE_TLS=true
SFT_ALLOWED_ORIGINS=https://127.0.0.1:5173,https://localhost:5173
SFT_MAX_CONNECTIONS=100
SFT_LOGIN_MAX_ATTEMPTS=5
SFT_LOGIN_WINDOW_MS=60000
SFT_NORMAL_BANDWIDTH_BPS=1048576
SFT_VIP_BANDWIDTH_BPS=5242880
SFT_UPLOAD_RESUME_TTL_MS=600000
VITE_HTTPS_CERT_PATH=certs/dev-server.pem
VITE_HTTPS_KEY_PATH=certs/dev-server-key.pem
VITE_WS_URL=wss://127.0.0.1:3000/ws

