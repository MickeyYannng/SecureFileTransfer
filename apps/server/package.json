{
  "name": "@sft/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:init": "tsx src/init-database.ts",
    "db:seed": "tsx src/init-database.ts --seed-test-users",
    "test": "npm run build && node --test dist/server.test.js dist/upload.test.js dist/download.test.js",
    "test:slow-upload": "npm run build && node --test dist/upload.slow.test.js",
    "test:slow-download": "npm run build && node --test dist/download.slow.test.js"
  },
  "dependencies": {
    "@sft/protocol": "file:../../packages/protocol",
    "argon2": "^0.45.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
